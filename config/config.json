        "sensor_sampling_rate": {
            "normal": 10,
            "low_battery": 30,
            "critical_battery": 60
        }
    },
    "ota": {
        "server_url": "https://updates.cubesat.example.com",
        "update_directory": "./updates",
        "backup_directory": "./backups",
        "current_version": "1.0.0",
        "auto_check_interval": 172800,
        "allow_beta_updates": false
    },
    "gpio": {
        "stm32_wake": 17,
        "pi_ready": 27,
        "led_status": 22
