        "beacon_interval": 60,
        "udp_port": 5000,
        "ground_station_ip": "192.168.1.100"
    },
    "security": {
        "shared_secret": "JDZs38pT0ickT703EbHTSvAuQpJG7KHevNu_C7Rs1Cc",
        "require_auth": true,
        "enable_signing": true,
        "ssl_enabled": false,
        "cert_file": "./certs/server.crt",
        "key_file": "./certs/server.key"
    },
    "logging": {
        "log_directory": "./logs",
        "console_output": false,
        "file_rotation_mb": 5,
        "backup_count": 3
    },
    "monitoring": {
        "cpu_threshold": 85.0,
        "memory_threshold": 90.0,
        "disk_threshold": 95.0,
        "temp_threshold": 75.0,
