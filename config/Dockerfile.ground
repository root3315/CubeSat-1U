# Dockerfile for CubeSat Ground Station
FROM python:3.9-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        git \
        curl \
        gnupg \
        build-essential \
        && rm -rf /var/lib/apt/lists/*

# Copy requirements first to leverage Docker cache
COPY ground-station/requirements.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --upgrade pip && pip install -r requirements.txt

# Install Streamlit separately to avoid conflicts
RUN pip install streamlit

# Copy project files
COPY . /app/

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/images /app/telemetry

# Create a non-root user for security
RUN adduser --disabled-password --gecos '' appuser
RUN chown -R appuser:appuser /app
USER appuser

# Expose port for Streamlit
EXPOSE 8501

# Run the ground station
CMD ["streamlit", "run", "ground-station/ground_station.py", "--server.port=8501", "--server.address=0.0.0.0"]